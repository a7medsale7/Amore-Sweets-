@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Email Confirmation Sent";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 600px;">
        <div class="card-body text-center p-5">
            <img src="https://cdn-icons-png.flaticon.com/512/561/561127.png"
                 alt="Email Sent" width="100" class="mb-4" />
            <h2 class="text-success mb-3">Check Your Email!</h2>
            <p class="text-muted fs-5">
                We’ve sent a confirmation link to your email address.
                Please open your inbox and click on the <strong>“Confirm Your Account”</strong> button
                to activate your Sweet Shop account.
            </p>
            <p class="text-secondary mt-4">
                Didn’t receive the email? <br />
                <a asp-page="./ResendEmailConfirmation" class="btn btn-outline-primary mt-3">
                    Resend Confirmation Email
                </a>
            </p>
        </div>
    </div>
</div>
