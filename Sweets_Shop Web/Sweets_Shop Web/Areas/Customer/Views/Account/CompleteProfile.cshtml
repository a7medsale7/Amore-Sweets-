@model Sweets.Models.ViewData.CompleteProfileVM

@{
    ViewData["Title"] = "Complete Your Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
                    <h2 class="mb-0">Complete Your Profile 📝</h2>
                </div>

                <div class="card-body p-4 p-md-5">

                    <div class="alert alert-info text-center mb-4" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <span class="fw-bold">Important:</span> You must complete your profile information below. Upon saving, you will be redirected to the home page to start your order.
                    </div>

                    <form asp-area="Customer" asp-controller="Account" asp-action="CompleteProfile" method="post" id="completeProfileForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="row mb-3 g-3">
                            <div class="col-md-6">
                                <label asp-for="ApplicationUser.Name" class="form-label fw-semibold">Full Name</label>
                                <input asp-for="ApplicationUser.Name" class="form-control" placeholder="Enter your full name" required />
                                <span asp-validation-for="ApplicationUser.Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ApplicationUser.PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                                <input asp-for="ApplicationUser.PhoneNumber" class="form-control" placeholder="e.g., +1 555-123-4567" />
                                <span asp-validation-for="ApplicationUser.PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h5 class="text-primary mb-3">Shipping Address Details</h5>

                        <div class="mb-3">
                            <label asp-for="ApplicationUser.StreetAddress" class="form-label fw-semibold">Street Address</label>
                            <input asp-for="ApplicationUser.StreetAddress" class="form-control" placeholder="Apartment, suite, or street number" required />
                            <span asp-validation-for="ApplicationUser.StreetAddress" class="text-danger small"></span>
                        </div>

                        <div class="row mb-4 g-3">
                            <div class="col-md-5">
                                <label asp-for="ApplicationUser.City" class="form-label fw-semibold">City</label>
                                <input asp-for="ApplicationUser.City" class="form-control" placeholder="e.g., New York" required />
                                <span asp-validation-for="ApplicationUser.City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="ApplicationUser.State" class="form-label fw-semibold">State / Region</label>
                                <input asp-for="ApplicationUser.State" class="form-control" placeholder="e.g., NY" required />
                                <span asp-validation-for="ApplicationUser.State" class="text-danger small"></span>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="ApplicationUser.PostalCode" class="form-label fw-semibold">Postal Code</label>
                                <input asp-for="ApplicationUser.PostalCode" class="form-control" placeholder="e.g., 10001" required />
                                <span asp-validation-for="ApplicationUser.PostalCode" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 mt-3" id="btnCompleteProfile">
                            <i class="bi bi-check-circle-fill me-2"></i> Save Profile and Start New Order
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let firstClickDone = false;
        const completeProfileButton = document.getElementById('btnCompleteProfile');
        const completeProfileForm = document.getElementById('completeProfileForm');

        if (completeProfileButton && completeProfileForm) {
            completeProfileButton.addEventListener('click', function(event) {
                event.preventDefault();

                if (completeProfileForm.checkValidity() === false) {
                    completeProfileForm.reportValidity();
                    return;
                }

                if (!firstClickDone) {
                    firstClickDone = true;

                    Swal.fire({
                        title: 'Verifying...',
                        text: 'We are validating your data...',
                        timer: 2000,
                        timerProgressBar: true,
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    }).then(() => {

                        // بعد انتهاء العداد، نرسل الفورم للـ Controller عبر AJAX
                        fetch('@Url.Action("CompleteProfileAjax", "Account", new { area = "Customer" })', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: JSON.stringify({
                                ApplicationUser: {
                                    Name: document.querySelector('[name="ApplicationUser.Name"]').value,
                                    PhoneNumber: document.querySelector('[name="ApplicationUser.PhoneNumber"]').value,
                                    StreetAddress: document.querySelector('[name="ApplicationUser.StreetAddress"]').value,
                                    City: document.querySelector('[name="ApplicationUser.City"]').value,
                                    State: document.querySelector('[name="ApplicationUser.State"]').value,
                                    PostalCode: document.querySelector('[name="ApplicationUser.PostalCode"]').value
                                }
                            })
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: '✔ Profile Verified & Updated',
                                    text: 'Click the button again to continue.'
                                });

                                completeProfileButton.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i> Click Again to Continue';
                                completeProfileButton.classList.remove('btn-success');
                                completeProfileButton.classList.add('btn-primary');
                            } else {
                                Swal.fire({
                            icon: 'info', // تم التعديل من success إلى info ليتناسب مع الخطوة التالية
                            title: '✔ Data Validated',
                            text: 'Click the "Save Profile and Start New Order" button again to continue with the submission.',
                            showConfirmButton: true
                        });
                            }
                        });
                    });
                } else {
                    // الضغط الثاني يرسل الفورم فعليًا
                    completeProfileForm.submit();
                }
            });
        }
    </script>
}
