@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header -->
            <div class="text-center mb-5">
                <h1 class="fw-bold text-primary">@ViewData["Title"]</h1>
                <p class="text-muted">Your privacy is important to us. Please read this policy carefully.</p>
            </div>

            <!-- Section 1 -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <h4 class="fw-semibold text-dark">
                        <i class="bi bi-shield-lock text-primary me-2"></i> Information We Collect
                    </h4>
                    <p class="text-muted">
                        We may collect personal details such as your name, email, and phone number when you register on our site.
                    </p>
                </div>
            </div>

            <!-- Section 2 -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <h4 class="fw-semibold text-dark">
                        <i class="bi bi-person-check text-success me-2"></i> How We Use Your Information
                    </h4>
                    <p class="text-muted">
                        Your information helps us provide better services, improve our website, and personalize your experience.
                    </p>
                </div>
            </div>

            <!-- Section 3 -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <h4 class="fw-semibold text-dark">
                        <i class="bi bi-lock text-danger me-2"></i> Data Protection
                    </h4>
                    <p class="text-muted">
                        We implement advanced security measures to keep your personal data safe and protected from unauthorized access.
                    </p>
                </div>
            </div>

            <!-- Section 4 -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <h4 class="fw-semibold text-dark">
                        <i class="bi bi-people text-warning me-2"></i> Sharing Information
                    </h4>
                    <p class="text-muted">
                        We do not sell, trade, or share your personal data with third parties without your consent.
                    </p>
                </div>
            </div>

            <!-- Section 5 -->
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h4 class="fw-semibold text-dark">
                        <i class="bi bi-envelope text-info me-2"></i> Contact Us
                    </h4>
                    <p class="text-muted">
                        If you have any questions about this privacy policy, please contact us at
                        <a href="mailto:support@yoursite.com">support@yoursite.com</a>.
                    </p>
                </div>
            </div>

            <!-- Footer -->
            <div class="text-center mt-4">
                <small class="text-muted">© @DateTime.Now.Year - Your Company Name. All rights reserved.</small>
            </div>
        </div>
    </div>
</div>
