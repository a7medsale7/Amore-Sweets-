@model IEnumerable<Sweets.Models.Product>

@{
    ViewData["Title"] = "Exclusive Delights";
}

<style>
    /* Custom styles for elegance and branding */
    .title-ribbon {
        display: inline-block;
        padding: 10px 40px;
        margin-bottom: 20px;
        color: white;
        background-color: var(--color-primary); /* Rich Brown background */
        border-radius: 50px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 2.25rem;
        letter-spacing: 1.5px;
        transform: rotate(-1deg);
        transition: transform 0.3s;
    }

        .title-ribbon:hover {
            transform: rotate(1deg);
        }

    .subtitle-text {
        color: var(--color-primary); /* Dark Chocolate Brown for subtitle */
        font-size: 1.25rem;
        font-style: italic;
    }

    /* ================================================= */
    /* == NEW: ELEGANT RECTANGULAR CARD STYLES == */
    /* ================================================= */

    .elegant-card {
        background-color: var(--color-light-cream); /* Light background for contrast */
        border: 2px solid var(--color-accent); /* Dusty Rose Border */
        border-radius: 12px; /* Soft rounded corners */
        overflow: hidden;
        transition: transform 0.4s ease, box-shadow 0.4s ease;
        position: relative;
    }

        .elegant-card:hover {
            transform: translateY(-8px);
            /* Stronger shadow using primary color for depth */
            box-shadow: 0 15px 35px rgba(140, 75, 61, 0.4);
        }

    .image-wrapper {
        position: relative;
        overflow: hidden;
        /* Define a fixed aspect ratio for the image container (e.g., 4:3) */
        padding-top: 66.66%;
    }

    .product-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover; /* Ensures the whole image is visible and covers the area */
        object-position: center;
        filter: brightness(1.05) contrast(1.05);
        transition: transform 0.6s ease;
    }

    .elegant-card:hover .product-img {
        transform: scale(1.1); /* Smooth zoom effect on hover */
    }

    .exclusive-tag {
        /* Positioned over the image */
        position: absolute;
        top: 15px;
        right: 15px;
        background-color: #ffc107; /* Gold/Yellow for luxury */
        color: var(--color-tertiary);
        padding: 5px 15px;
        border-radius: 20px;
        font-weight: 900;
        font-size: 0.9rem;
        z-index: 10;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    }

    .product-price {
        color: var(--color-primary);
        font-size: 1.75rem;
        font-family: 'Playfair Display', serif;
        margin: 10px 0;
        font-weight: 800;
    }

    .btn-view-elegant {
        background-color: var(--color-accent);
        color: var(--color-tertiary);
        border: none;
        font-weight: 700;
        letter-spacing: 1px;
        padding: 12px 0;
        border-radius: 50px;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

        .btn-view-elegant:hover {
            background-color: var(--color-primary);
            color: var(--color-light-cream);
        }
</style>

<div class="container py-5 mt-5">
    <div class="text-center mb-5" data-aos="fade-down">
        @* Enhanced Title to stress EXCLUSIVE *@
        <h1 class="title-ribbon">
            <i class="bi bi-gem me-2"></i> Amoré Exclusive Delights <i class="bi bi-gem ms-2"></i>
        </h1>
        <p class="subtitle-text">Each piece is a limited, handcrafted masterpiece. Discover the difference.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-lg rounded-3 p-4" data-aos="fade-up">
            <h4 class="alert-heading text-primary"><i class="bi bi-info-circle-fill"></i> No Specials Today!</h4>
            <p>We're busy baking new creations! Please check back soon for our featured products.</p>
            <hr>
            <a asp-area="Customer" asp-controller="Product" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-shop"></i> Browse All Products
            </a>
        </div>
    }
    else
    {
        <div class="row g-5">
            @foreach (var product in Model)
            {
                var image = product.ProductImages?.FirstOrDefault()?.ImageUrl ?? "https://placehold.co/400x300/E3B5A7/5C4033/png?text=Amor%C3%A9+Delight";
                <div class="col-12 col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="@(Model.ToList().IndexOf(product) * 150)">
                    <div class="card h-100 elegant-card text-center">

                        @* Rectangular Image Container (Wrapper) *@
                        <div class="image-wrapper">
                            <span class="exclusive-tag"><i class="bi bi-star-fill me-1"></i> EXCLUSIVE</span>
                            <img src="@image" class="product-img" alt="@product.Name" />
                        </div>
                        @* End Image Wrapper *@

                        <div class="card-body d-flex flex-column p-4">
                            <h4 class="card-title fw-bold text-primary mb-1">@product.Name</h4>
                            <p class="text-muted small mb-3">@product.Category?.Name</p>

                            <p class="product-price flex-grow-1">@product.Price.ToString("C")</p>

                            <a asp-area="Customer" asp-controller="Home" asp-action="Details" asp-route-slug="@product.Slug"
                               class="btn btn-view-elegant mt-2">
                                <i class="bi bi-box-arrow-in-right"></i> View Masterpiece
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>