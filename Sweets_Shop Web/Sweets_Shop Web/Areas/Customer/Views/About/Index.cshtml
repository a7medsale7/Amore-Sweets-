@{
    ViewData["Title"] = "About Us - Our Story | Amoré Sweet Boutique";
}

<style>
    /* Inherit global variables from _Layout for consistency */
    :root {
        --color-primary: #8C4B3D; /* Deep Rose/Brown */
        --color-secondary: #E3B5A7; /* Soft Rose */
        --color-tertiary: #5C4033; /* Rich Brown */
        --color-background-light: #F8F4F2; /* Creamy light background */
        --color-text-dark: #333;
    }

    /* Hero Banner for the About Page */
    .about-hero {
        background: linear-gradient(10deg, var(--color-background-light), #fff) no-repeat;
        padding: 80px 0;
        border-bottom: 5px solid var(--color-secondary);
        position: relative;
        overflow: hidden;
    }

        .about-hero h1 {
            font-family: 'Playfair Display', serif;
            color: var(--color-primary);
            font-size: 3.5rem;
            margin-bottom: 10px;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1);
        }

        .about-hero p.lead {
            color: var(--color-tertiary);
            font-weight: 300;
            font-size: 1.3rem;
        }

    /* Section for The Story */
    .story-section {
        background-color: #fff;
        padding: 60px 0;
    }

        .story-section img {
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            transition: transform 0.5s ease;
        }

            .story-section img:hover {
                transform: scale(1.03);
            }

    /* Section for Mission/Values */
    .values-section {
        background-color: var(--color-background-light);
        padding: 80px 0;
        position: relative;
    }

    .value-card {
        background-color: #ffffff;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        border-top: 5px solid var(--color-secondary);
        height: 100%;
        transition: all 0.3s ease;
    }

        .value-card:hover {
            transform: translateY(-5px);
            border-top-color: var(--color-primary);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

    .value-icon {
        color: var(--color-primary);
        font-size: 2.5rem;
        margin-bottom: 15px;
    }

    /* Team Section */
    .team-section {
        padding: 80px 0;
    }

    .team-member-card {
        background: #ffffff;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        text-align: center;
        transition: all 0.3s ease;
    }

        .team-member-card:hover {
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            transform: scale(1.05);
        }

        .team-member-card img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-bottom: 3px solid var(--color-secondary);
        }

    .member-info {
        padding: 20px;
    }

        .member-info h5 {
            color: var(--color-tertiary);
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .member-info small {
            color: var(--color-primary);
            display: block;
            font-style: italic;
        }

    /* General Typography */
    .section-heading {
        font-family: 'Playfair Display', serif;
        color: var(--color-tertiary);
        font-size: 2.5rem;
        margin-bottom: 40px;
        text-align: center;
    }

    .text-rich-brown {
        color: var(--color-tertiary) !important;
    }

    .text-primary-color {
        color: var(--color-primary) !important;
    }

    .team-section {
        background-color: var(--color-background-light);
        padding: 60px 0;
    }

    .section-heading {
        font-family: 'Playfair Display', serif;
        color: var(--color-primary);
        font-weight: 800 !important;
        font-size: 2.5rem;
        text-align: center;
    }

    .team-member-card {
        background-color: #ffffff;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .team-member-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        /* ---------------------------------
           تحسين عرض الصورة (لتظهر كاملة وأكبر)
        --------------------------------- */
        .team-member-card img {
            /* تحديد ارتفاع ثابت أكبر للصورة (أكثر بروزًا) */
            height: 300px;
            width: 100%;
            /* التأكد من أن الصورة تغطي المساحة دون تشويه وتظهر من الأعلى */
            object-fit: cover;
            object-position: top center; /* هذا يضمن بدء عرض الصورة من الأعلى */
            border-bottom: 5px solid var(--color-accent); /* خط فاصل أنيق */
        }

    .member-info {
        padding: 25px 20px;
        flex-grow: 1; /* لتوزيع المساحة بشكل متساوٍ بين البطاقات */
    }

        .member-info h5 {
            font-weight: 700;
            color: var(--color-text-dark);
            margin-bottom: 5px;
        }

        .member-info small {
            display: block;
            color: var(--color-primary);
            font-weight: 600;
            margin-bottom: 10px;
            font-size: 0.95rem;
        }

        .member-info p {
            font-size: 0.9rem;
        }
</style>

<section class="about-hero text-center mb-5">
    <div class="container">
        <h1 class="fw-bold" data-aos="fade-down">
            Our Sweet Legacy: The Amoré Story
        </h1>
        <p class="lead" data-aos="fade-up" data-aos-delay="200">
            More than just sweets—it's a tradition of passion, quality, and artisan craft.
        </p>
    </div>
</section>

<section class="story-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0 order-lg-1" data-aos="fade-right" data-aos-duration="1000">
                <img src="/images/Founding Baker in a traditional kitchen.jpg" class="img-fluid" alt="Founding Baker in a traditional kitchen">
            </div>
            <div class="col-lg-6 order-lg-0" data-aos="fade-left" data-aos-duration="1000">
                <h2 class="section-heading text-start text-rich-brown">The Birth of Amoré Patisserie 🎂</h2>
                <p class="text-muted fs-5">
                    **Amoré Sweet Boutique** was founded in 2020 by **Elias and Sofia**, a couple who believed that the simplest joy in life comes from the finest ingredients, baked with genuine care. Starting from a humble home kitchen, their dream was simple: to bring the authentic taste of European patisserie to every home.
                </p>
                <p class="text-muted fs-5">
                    The name "**Amoré**" means *love* in Italian, and that's precisely what goes into every cake, cookie, and confection we create. We honor classic techniques while embracing modern, delectable flavor profiles.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="values-section">
    <div class="container">
        <h2 class="section-heading" data-aos="fade-down">Our Guiding Principles 🌟</h2>
        <div class="row g-4 text-center">

            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="value-card">
                    <i class="bi bi-star-fill value-icon"></i>
                    <h4 class="text-primary-color fw-bold">Uncompromising Quality</h4>
                    <p class="text-muted mb-0">We use only the highest-grade butter, French chocolate, and locally sourced fruits and flours. **No compromise.**</p>
                </div>
            </div>

            <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="value-card">
                    <i class="bi bi-heart-fill value-icon"></i>
                    <h4 class="text-primary-color fw-bold">Artisan Craftsmanship</h4>
                    <p class="text-muted mb-0">Every treat is handcrafted by our expert pastry chefs, dedicating time and precision to ensure perfection.</p>
                </div>
            </div>

            <div class="col-md-4" data-aos="fade-up" data-aos-delay="500">
                <div class="value-card">
                    <i class="bi bi-tree-fill value-icon"></i>
                    <h4 class="text-primary-color fw-bold">Sustainability</h4>
                    <p class="text-muted mb-0">We are committed to reducing our environmental footprint through sustainable packaging and ethical sourcing practices.</p>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="team-section">
    <div class="container">
        <h2 class="section-heading" data-aos="fade-down">Meet The Master Bakers 👨‍🍳👩‍🍳</h2>
        <div class="row justify-content-center g-4">

            <div class="col-md-4 col-sm-6" data-aos="zoom-in" data-aos-delay="100">
                <div class="team-member-card">
                    <img src="/images/mohammed saleh.jpg" alt="Elias - Head Baker">
                    <div class="member-info">
                        <h5>Mohammed Salah</h5>
                        <small>Head Pastry Chef & Co-Founder</small>
                        <p class="mt-2 text-muted fst-italic">"My passion is turning simple ingredients into edible art."</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-sm-6" data-aos="zoom-in" data-aos-delay="300">
                <div class="team-member-card">
                    <img src="/images/kuan.jpg" alt="Sofia - Operations Manager">
                    <div class="member-info">
                        <h5>Juan Bezerra</h5>
                        <small>Operations & Brand Manager</small>
                        <p class="mt-2 text-muted fst-italic">"We strive for excellence in every customer experience, from click to bite."</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-sm-6" data-aos="zoom-in" data-aos-delay="500">
                <div class="team-member-card">
                    <img src="/images/cristiano ronaldo.jpg" alt="David - Chocolatier">
                    <div class="member-info">
                        <h5>Cristiano Ronaldo</h5>
                        <small>Lead Chocolatier Specialist</small>
                        <p class="mt-2 text-muted fst-italic">"The perfect truffle is a balance of texture, aroma, and rich flavor."</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
<section class="py-5 text-center" style="background-color: var(--color-primary);">
    <div class="container">
        <h3 class="fw-bold text-white mb-3" data-aos="zoom-in">Ready to Indulge?</h3>
        <p class="lead text-white-50 mb-4" data-aos="zoom-in" data-aos-delay="200">
            Explore our handcrafted menus and taste the Amoré difference today.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-lg shadow-lg" style="background-color: #fff; color: var(--color-primary); font-weight: bold;" data-aos="zoom-in" data-aos-delay="400">
            View All Categories <i class="bi bi-arrow-right-short"></i>
        </a>
    </div>
</section>

@section Scripts {
    <script>
        // AOS.init is typically in _Layout, but keeping this here ensures it works if needed.
        if (typeof AOS !== 'undefined') {
            AOS.refresh();
        }
    </script>
}