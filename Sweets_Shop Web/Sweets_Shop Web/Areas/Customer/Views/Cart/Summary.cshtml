@using Sweets.Models.ViewData
@model ShoppingCartVM
<partial name="_Notification" />

<form method="post">
    <div class="container py-5">
        <div class="card app-card">

            <div class="card-header app-card-header">
                <div class="row px-4 align-items-center">
                    <div class="col-6">
                        <h4 class="pt-2 text-white"><i class="bi bi-check-circle-fill me-2"></i> Order Summary</h4>
                    </div>
                    <div class="col-6 text-end">
                        <a asp-action="Index" class="btn btn-outline-light btn-sm px-4"><i class="bi bi-arrow-left"></i> Back to Cart</a>
                    </div>
                </div>
            </div>

            <div class="card-body p-5">
                <div class="row">

                    <div class="col-12 col-lg-6 pb-4 border-end">
                        <h4 class="text-brand-info mb-4">Shipping Details</h4>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label text-muted">Name</label>
                                <input asp-for="OrderHeader.Name" class="form-control" />
                                <span asp-validation-for="OrderHeader.Name" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted">Phone</label>
                                <input asp-for="OrderHeader.PhoneNumber" class="form-control" />
                                <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted">Street Address</label>
                                <input asp-for="OrderHeader.StreetAddress" class="form-control" />
                                <span asp-validation-for="OrderHeader.StreetAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted">City</label>
                                <input asp-for="OrderHeader.City" class="form-control" />
                                <span asp-validation-for="OrderHeader.City" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted">State</label>
                                <input asp-for="OrderHeader.State" class="form-control" />
                                <span asp-validation-for="OrderHeader.State" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted">Postal Code</label>
                                <input asp-for="OrderHeader.PostalCode" class="form-control" />
                                <span asp-validation-for="OrderHeader.PostalCode" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-5 offset-lg-1">
                        <h4 class="text-brand-info mb-4">Order Details</h4>
                        <ul class="list-group mb-4">
                            @foreach (var details in Model.ShoppingCartList)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div class="d-flex flex-column">
                                        <h6 class="my-0 fw-semibold">@details.Product.Name</h6>
                                        <small class="text-muted">Qty: @details.Count @(details.Count > 1 ? "items" : "item")</small>
                                    </div>
                                    <span class="text-brand-info">@((details.Price * details.Count).ToString("c"))</span>
                                </li>
                            }

                            <li class="list-group-item d-flex justify-content-between align-items-center bg-brand-light mt-3">
                                <h5 class="text-dark fw-bold mb-0">Total (USD)</h5>
                                <h4 class="text-dark fw-bolder mb-0">@Model.OrderHeader.OrderTotal.ToString("c")</h4>
                            </li>
                        </ul>

                        <div class="alert alert-warning small mt-4" role="alert">
                            <i class="bi bi-truck me-2"></i>
                            Estimated Arrival: @DateTime.Now.AddDays(7).ToShortDateString() - @DateTime.Now.AddDays(14).ToShortDateString()
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white pt-3 pb-5">
                <div class="row">
                    <div class="col-12 text-center">
                        <button type="submit" class="btn btn-brand-primary w-50 py-3">
                            <i class="bi bi-cart-check-fill me-2"></i> Place Order & Pay Later
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
