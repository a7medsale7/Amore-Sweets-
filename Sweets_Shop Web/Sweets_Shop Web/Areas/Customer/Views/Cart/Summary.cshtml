@using Sweets.Models.ViewData
@model ShoppingCartVM
<partial name="_Notification" />

<form method="post">
    <div class="container py-5">
        <div class="card shadow-lg border-0 rounded-4">

            <div class="card-header bg-dark text-white py-3 rounded-top-4">
                <div class="row px-4 align-items-center">
                    <div class="col-6">
                        <h4 class="pt-2 mb-0"><i class="bi bi-check-circle-fill me-2"></i> Order Summary</h4>
                    </div>
                    <div class="col-6 text-end">
                        <a asp-action="Index" class="btn btn-outline-light btn-sm px-4">
                            <i class="bi bi-arrow-left"></i> Back to Cart
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="row">

                    <!-- 🧾 Shipping Details -->
                    <div class="col-12 col-lg-6 pb-4 border-end">
                        <h4 class="text-primary mb-3">Shipping Details (Your Information)</h4>

                        <div class="alert alert-primary small mb-4" role="alert">
                            <i class="bi bi-person-check-fill me-2"></i>
                            <span class="fw-bold">Review and Confirm:</span> These shipping details are pre-filled from your profile. Please review them and make any necessary one-time changes for this order.
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label text-muted fw-semibold">Name</label>
                                <input disabled asp-for="OrderHeader.Name" class="form-control form-control-lg" />
                                <span asp-validation-for="OrderHeader.Name" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted fw-semibold">Phone</label>
                                <input disabled asp-for="OrderHeader.PhoneNumber" class="form-control" />
                                <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted fw-semibold">Street Address</label>
                                <input disabled asp-for="OrderHeader.StreetAddress" class="form-control" />
                                <span asp-validation-for="OrderHeader.StreetAddress" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted fw-semibold">City</label>
                                <input disabled asp-for="OrderHeader.City" class="form-control" />
                                <span asp-validation-for="OrderHeader.City" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted fw-semibold">State</label>
                                <input disabled asp-for="OrderHeader.State" class="form-control" />
                                <span asp-validation-for="OrderHeader.State" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted fw-semibold">Postal Code</label>
                                <input disabled asp-for="OrderHeader.PostalCode" class="form-control" />
                                <span asp-validation-for="OrderHeader.PostalCode" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 🛒 Order Details (conditional display) -->
                    @if (Model.OrderHeader.OrderTotal > 0)
                    {
                        <div class="col-12 col-lg-5 offset-lg-1">
                            <h4 class="text-primary mb-4">Order Details</h4>
                            <ul class="list-group mb-4 rounded-3 shadow-sm">
                                <li class="list-group-item bg-light fw-bold text-dark d-flex justify-content-between align-items-center">
                                    <div class="col-6">Product</div>
                                    <div class="col-2 text-center">Price</div>
                                    <div class="col-2 text-center">Qty</div>
                                    <div class="col-2 text-end">Total</div>
                                </li>

                                @foreach (var details in Model.ShoppingCartList)
                                {
                                    var subtotal = details.Price * details.Count;

                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div class="col-6">
                                            <h6 class="my-0 fw-semibold text-dark">@details.Product.Name</h6>
                                            <small class="text-muted">
                                                @details.Product.Description?.Substring(0, Math.Min(40, details.Product.Description.Length))...
                                            </small>
                                        </div>
                                        <div class="col-2 text-center text-muted">
                                            @details.Price.ToString("c")
                                        </div>
                                        <div class="col-2 text-center text-muted">
                                            @details.Count
                                        </div>
                                        <div class="col-2 text-end text-success fw-bold">
                                            @subtotal.ToString("c")
                                        </div>
                                    </li>
                                }

                                <li class="list-group-item d-flex justify-content-between align-items-center bg-light mt-3 py-3">
                                    <h5 class="text-dark fw-bold mb-0">Order Total (USD)</h5>
                                    <h4 class="text-danger fw-bolder mb-0">@Model.OrderHeader.OrderTotal.ToString("c")</h4>
                                </li>
                            </ul>

                            <div class="alert alert-warning small mt-4" role="alert">
                                <i class="bi bi-truck me-2"></i>
                                **Estimated Arrival:** @DateTime.Now.AddDays(7).ToShortDateString() - @DateTime.Now.AddDays(14).ToShortDateString()
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-12 col-lg-5 offset-lg-1">
                            <div class="alert alert-info mt-4">
                                <i class="bi bi-basket2-fill me-2"></i>
                                No order details to display — your cart is empty or prices are all free.
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card-footer bg-light pt-4 pb-5 rounded-bottom-4">
                <div class="row">
                    <div class="col-12 text-center">

                        @if (Model.OrderHeader.OrderTotal > 0)
                        {
                            <button type="submit" class="btn btn-dark w-75 py-3 shadow-lg">
                                <i class="bi bi-cart-check-fill me-2"></i> Place Order & Pay Later
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-info mt-3 w-75 mx-auto">
                                <i class="bi bi-info-circle-fill me-2"></i>
                                This order is free — no payment is required.
                            </div>
                        }

                    </div>
                </div>
            </div>


        </div>
    </div>
</form>
