@using Sweets.Models.ViewData
@model ShoppingCartVM
<partial name="_Notification" />

<form method="post">
    <div class="container py-5">
        <div class="card shadow-lg border-0 rounded-4">

            <div class="card-header bg-primary bg-gradient text-white py-4 rounded-top-4">
                <h3 class="pt-1 mb-0 text-center text-uppercase">
                    <i class="bi bi-basket-fill me-3"></i> Your Shopping Cart
                </h3>
            </div>

            <div class="card-body p-4 p-md-5">

                @if (Model.ShoppingCartList != null && Model.ShoppingCartList.Any())
                {
                    double calculatedOrderTotal = 0;

                    <div class="row d-none d-lg-flex fw-bold text-secondary border-bottom mb-3 pb-2 small text-uppercase">
                        <div class="col-1"></div>
                        <div class="col-4 text-start">Product Details</div>
                        <div class="col-2 text-center">Price</div>
                        <div class="col-2 text-center">Quantity</div>
                        <div class="col-3 text-end">Subtotal</div>
                    </div>

                    @foreach (var item in Model.ShoppingCartList)
                    {
                        double price = item.Price;
                        double subtotal = price * item.Count;
                        calculatedOrderTotal += subtotal;

                        <div class="row align-items-center mb-4 pb-4 border-bottom border-secondary-subtle">

                            <div class="col-3 col-lg-1 text-center">
                                @{
                                    var firstImage = item.Product.ProductImages?.FirstOrDefault()?.ImageUrl ?? "https://placehold.co/100x100/E9ECEF/495057/png?text=No+Image";
                                }
                                <img src="@firstImage" alt="@item.Product.Name" class="rounded-3 shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" />
                            </div>

                            <div class="col-9 col-lg-4 pt-2 text-start">
                                <h5 class="text-uppercase text-dark mb-1 fw-bold">@item.Product.Name</h5>
                                <p class="text-muted small mb-0 d-none d-md-block">
                                    <small>@Html.Raw(item.Product.Description != null && item.Product.Description.Length > 60 ? item.Product.Description.Substring(0, 60) + "..." : item.Product.Description)</small>
                                </p>
                            </div>

                            <div class="col-6 col-lg-2 text-center pt-2 pt-lg-0">
                                <span class="d-lg-none d-block fw-semibold text-muted small">Price:</span>
                                <h6 class="fw-bold text-dark mb-0">@price.ToString("c")</h6>
                            </div>

                            <div class="col-6 col-lg-2 text-center pt-2 pt-lg-0">
                                <div class="input-group w-75 mx-auto border border-secondary-subtle rounded-pill overflow-hidden">
                                    <a asp-action="minus" asp-route-cartId="@item.Id" class="btn btn-sm btn-light border-0">
                                        <i class="bi bi-dash"></i>
                                    </a>
                                    <input type="text" value="@item.Count" class="form-control text-center border-0 fw-bold p-1 bg-white" readonly />
                                    <a asp-action="plus" asp-route-cartId="@item.Id" class="btn btn-sm btn-light border-0">
                                        <i class="bi bi-plus"></i>
                                    </a>
                                </div>
                            </div>

                            <div class="col-12 col-lg-3 text-end pt-3 pt-lg-0">
                                <div class="d-flex flex-row flex-lg-column align-items-center justify-content-between align-items-lg-end">

                                    <p class="text-muted small mb-1 d-none d-lg-block">
                                        @price.ToString("c") &times; @item.Count
                                    </p>

                                    <h5 class="fw-bolder text-success mb-2 me-3 me-lg-0">@subtotal.ToString("c")</h5>

                                    <a asp-action="remove" asp-route-cartId="@item.Id" class="btn btn-sm btn-outline-danger mt-lg-2" title="Remove Item">
                                        <i class="bi bi-trash-fill"></i> <span class="d-none d-lg-inline">Remove</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    <input asp-for="OrderHeader.OrderTotal" value="@calculatedOrderTotal" hidden />

                    <div class="card-footer bg-white border-0 mt-4 pt-3">
                        <div class="row align-items-center">

                            <div class="col-md-5 order-3 order-md-1 mb-3 mb-md-0">
                                <a asp-area="Customer" asp-controller="Home" asp-action="Index"
                                   class="btn btn-outline-secondary w-100 py-2 text-uppercase fw-semibold">
                                    <i class="bi bi-arrow-left-circle-fill me-2"></i> Continue Shopping
                                </a>
                            </div>

                            <div class="col-md-7 order-1 order-md-3">
                                <ul class="list-group mb-4 shadow-sm border border-primary">
                                    <li class="list-group-item d-flex justify-content-between align-items-center bg-light p-3">
                                        <h4 class="text-dark fw-bold text-uppercase mb-0">Order Total (USD)</h4>
                                        <h3 class="text-primary fw-bolder mb-0">@calculatedOrderTotal.ToString("c")</h3>
                                    </li>
                                </ul>

                                <button type="button" class="btn btn-primary border-0 bg-gradient w-100 py-3 fs-5 fw-bold text-uppercase"
                                        data-bs-toggle="modal" data-bs-target="#userInfoModal">
                                    <i class="bi bi-cart-check me-2"></i> Proceed to Summary
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info text-center p-5 border border-info rounded-3 shadow-sm" role="alert">
                        <i class="bi bi-bag-x-fill display-3 text-info mb-3"></i>
                        <h4 class="fw-bold text-dark">Your shopping cart is currently empty!</h4>
                        <p class="mb-0 text-muted">Time to fill it up with some delicious sweets! 😋</p>
                        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary bg-gradient mt-4 px-5 btn-lg">
                            <i class="bi bi-shop me-2"></i> Start Shopping Now
                        </a>
                    </div>
                }

            </div>
        </div>
    </div>
</form>

---

## 👤 Refined User Information Modal

```html
<div class="modal fade" id="userInfoModal" tabindex="-1" aria-labelledby="userInfoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header border-bottom-0 p-4">
                <h5 class="modal-title fw-bold text-primary" id="userInfoModalLabel">
                    <i class="bi bi-person-circle me-2"></i> Your Personal and Shipping Information
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4 pt-0">
                @if (Model.OrderHeader.ApplicationUser != null)
                {
                    <h6 class="mb-3 text-muted border-bottom pb-2">Account and Shipping Details</h6>

                    <dl class="row gy-2">
                        <dt class="col-sm-4 text-start text-md-end fw-semibold text-dark">Full Name:</dt>
                        <dd class="col-sm-8">@Model.OrderHeader.Name</dd>

                        <dt class="col-sm-4 text-start text-md-end fw-semibold text-dark">Phone Number:</dt>
                        <dd class="col-sm-8">@Model.OrderHeader.PhoneNumber</dd>

                        <dt class="col-12"><hr class="my-3"></dt>

                        <dt class="col-sm-4 text-start text-md-end fw-semibold text-dark">Street Address:</dt>
                        <dd class="col-sm-8">@Model.OrderHeader.StreetAddress</dd>

                        <dt class="col-sm-4 text-start text-md-end fw-semibold text-dark">City:</dt>
                        <dd class="col-sm-8">@Model.OrderHeader.City</dd>

                        <dt class="col-sm-4 text-start text-md-end fw-semibold text-dark">State:</dt>
                        <dd class="col-sm-8">@Model.OrderHeader.State</dd>

                        <dt class="col-sm-4 text-start text-md-end fw-semibold text-dark">Postal Code:</dt>
                        <dd class="col-sm-8">@Model.OrderHeader.PostalCode</dd>
                    </dl>

                    <div class="d-grid gap-2 mt-4">
                        <a asp-area="Customer" asp-controller="Account" asp-action="EditProfile" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-pencil-square me-2"></i> Edit Information
                        </a>
                        <button type="button" class="btn btn-success btn-lg" onclick="location.href='@Url.Action("Summary", "Cart", new { area = "Customer" })'">
                            <i class="bi bi-credit-card-fill me-2"></i> Proceed to Payment
                        </button>
                    </div>

                }
                else
                {
                    <div class="alert alert-warning" role="alert">
                        <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i> Your Profile is Incomplete!</h4>
                        <p class="text-dark">To continue and complete the payment process, you must fill out your shipping and contact details.</p>
                        <hr>
                        <a asp-area="Customer" asp-controller="Account" asp-action="CompleteProfile" class="btn btn-danger w-100">
                            <i class="bi bi-person-fill-add me-2"></i> Complete Profile Now
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>