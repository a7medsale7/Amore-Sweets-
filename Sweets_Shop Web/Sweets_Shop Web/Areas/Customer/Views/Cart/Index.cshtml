@using Sweets.Models.ViewData
@model ShoppingCartVM
<partial name="_Notification" />

<form method="post">
    <div class="container py-5">
        <div class="card shadow border-0">

            <div class="card-header bg-dark bg-gradient text-white py-4">
                <h3 class="pt-1 mb-0 text-center">
                    <i class="bi bi-basket-fill me-2"></i> Shopping Cart
                </h3>
            </div>

            <div class="card-body p-4 p-md-5">

                @if (Model.ShoppingCartList != null && Model.ShoppingCartList.Any())
                {
                    // ⭐️ 1. حساب الإجمالي الكلي مباشرة في الـ View باستخدام double
                    double calculatedOrderTotal = 0;

                    // رأس الجدول للشاشات الكبيرة
                    <div class="row d-none d-lg-flex fw-bold text-muted border-bottom mb-3 pb-2 small text-center">
                        <div class="col-1"></div>
                        <div class="col-4 text-start">Product</div>
                        <div class="col-2">Price</div>
                        <div class="col-2">Quantity</div>
                        <div class="col-3 text-end">Subtotal</div>
                    </div>

                    @foreach (var item in Model.ShoppingCartList)
                    {
                        // حساب الإجمالي الفرعي
                        double price = item.Price;
                        double subtotal = price * item.Count;
                        calculatedOrderTotal += subtotal;

                        <div class="row align-items-center mb-4 pb-3 border-bottom border-light">

                            <div class="col-3 col-lg-1 text-center">
                                @{
                                    var firstImage = item.Product.ProductImages?.FirstOrDefault()?.ImageUrl ?? "https://placehold.co/100x100/CCCCCC/333333/png?text=No+Image";
                                }
                                <img src="@firstImage" alt="@item.Product.Name" class="rounded shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" />
                            </div>

                            <div class="col-9 col-lg-4 pt-2 text-start">
                                <h6 class="text-uppercase text-dark mb-1"><strong>@item.Product.Name</strong></h6>
                                <p class="text-muted small mb-0 d-none d-md-block">
                                    <small>@Html.Raw(item.Product.Description != null && item.Product.Description.Length > 80 ? item.Product.Description.Substring(0, 80) + "..." : item.Product.Description)</small>
                                </p>
                            </div>

                            <div class="col-6 col-lg-2 text-center pt-2 pt-lg-0">
                                <span class="d-lg-none d-block fw-semibold text-muted small">Price:</span>
                                <h6 class="fw-semibold text-dark mb-0">@price.ToString("c")</h6>
                            </div>

                            <div class="col-6 col-lg-2 text-center pt-2 pt-lg-0">
                                <div class="input-group w-75 mx-auto">
                                    <a asp-action="minus" asp-route-cartId="@item.Id" class="btn btn-outline-secondary py-2 border-end-0">
                                        <i class="bi bi-dash-square"></i>
                                    </a>
                                    <input type="text" value="@item.Count" class="form-control text-center bg-white fw-bold p-1" readonly style="max-width: 50px;" />
                                    <a asp-action="plus" asp-route-cartId="@item.Id" class="btn btn-outline-secondary py-2 border-start-0">
                                        <i class="bi bi-plus-square"></i>
                                    </a>
                                </div>
                            </div>

                            <div class="col-12 col-lg-3 text-end pt-3 pt-lg-0">
                                <div class="d-flex flex-row flex-lg-column align-items-center justify-content-between align-items-lg-end">

                                    <p class="text-muted small mb-1 d-none d-lg-block">
                                        @price.ToString("c") &times; @item.Count
                                    </p>

                                    <h5 class="fw-bolder text-primary mb-2 me-3 me-lg-0">@subtotal.ToString("c")</h5>

                                    <a asp-action="remove" asp-route-cartId="@item.Id" class="btn btn-sm btn-danger mt-lg-2" title="Remove Item">
                                        <i class="bi bi-trash-fill"></i> <span class="d-none d-lg-inline">Remove</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    <input asp-for="OrderHeader.OrderTotal" value="@calculatedOrderTotal" hidden />

                    <div class="card-footer bg-white border-0 mt-4 pt-3">
                        <div class="row">
                            <div class="col-md-4 order-2 order-md-1 mb-3 mb-md-0">
                                <a asp-area="Customer" asp-controller="Home" asp-action="Index"
                                   class="btn btn-outline-secondary w-100 py-2 text-uppercase fw-semibold">
                                    <i class="bi bi-shop me-2"></i> Continue Shopping
                                </a>
                            </div>

                            <div class="col-md-6 offset-md-2 order-1 order-md-2">
                                <ul class="list-group mb-4 shadow">
                                    <li class="list-group-item d-flex justify-content-between align-items-center bg-light p-3">
                                        <h4 class="text-dark fw-bold text-uppercase mb-0">Order Total (USD)</h4>
                                        <h3 class="text-primary fw-bolder mb-0">@calculatedOrderTotal.ToString("c")</h3>
                                    </li>
                                </ul>

                                <button type="submit" asp-action="Summary" class="btn btn-success border-0 bg-gradient w-100 py-2 fs-5 fw-bold">
                                    <i class="bi bi-cart-check me-2"></i> Proceed to Summary
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning text-center p-5 border border-warning rounded shadow-sm" role="alert">
                        <i class="bi bi-bag-x display-4 text-warning mb-3"></i>
                        <h4 class="fw-bold text-dark">Your shopping cart is currently empty!</h4>
                        <p class="mb-0 text-muted">Time to fill it up with some delicious sweets! 😋</p>
                        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary bg-gradient mt-4 px-5">
                            <i class="bi bi-shop me-2"></i> Start Shopping Now
                        </a>
                    </div>
                }

            </div>
        </div>
    </div>
</form>