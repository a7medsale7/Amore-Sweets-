@* يجب إضافة الأنماط في الملفات المشتركة أو وضعها في هذه الصفحة كما هو موضح في القسم الأول *@

@using Sweets.Models.ViewData
@model RoleManagmentVM

@{
    ViewData["Title"] = "Users List";
}
<style>
    /* 🎨 تحديد الثوابت اللونية للثيم */
    :root {
        --color-primary-dark: #6B4226; /* بني غامق */
        --color-secondary-light: #F8BBD0; /* وردي فاتح */
        --color-bg-table-alt: #FFF0D9; /* خلفية صفوف متبادلة (كريمي) */
        --color-header-bg-bright: #FEE7D7; /* خلفية رأس الجدول */
        --color-header-text: #6B4226; /* لون نص رأس الجدول */
        --color-action-info: #0d6efd;
        --color-action-danger: #dc3545;
        --color-action-success: #198754;
    }

    body {
        background-color: #FFF8F0;
    }

    /* تحسين البطاقة (Card) في كلتا الصفحتين */
    .custom-card {
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        border: 1px solid var(--color-secondary-light) !important;
    }

    .custom-card-header {
        background-color: var(--color-primary-dark) !important;
        color: #fff;
        border-top-left-radius: 14px;
        border-top-right-radius: 14px;
        font-weight: 700;
    }

    /* 📊 تصميم جدول قائمة المستخدمين */
    #tblData {
        background-color: #ffffff;
        border-radius: 10px;
        overflow: hidden;
        border: none !important;
    }

        #tblData thead {
            background-color: var(--color-header-bg-bright);
            font-weight: 700;
        }

        #tblData th {
            padding: 15px 10px;
            font-size: 0.95rem;
            color: var(--color-header-text);
            text-align: center;
            text-transform: uppercase;
            border-bottom: 2px solid rgba(107, 66, 38, 0.2) !important;
        }

        #tblData tbody tr:nth-child(even) {
            background-color: var(--color-bg-table-alt);
        }

        #tblData tbody tr:hover {
            background-color: #FEE7D7;
        }

        #tblData td {
            vertical-align: middle;
            padding: 12px 10px;
            border-top: 1px solid #eee;
            font-size: 0.9rem;
            text-align: center;
        }

    /* ⚙️ أزرار الإجراءات */
    .btn-actions-group .btn {
        width: 40px;
        height: 40px;
        padding: 8px;
        border-radius: 8px;
        font-size: 1rem;
        margin: 0 2px;
    }

    /* تنسيق خاص للأدوار (Roles) */
    .role-badge {
        font-size: 0.85rem;
        padding: 6px 12px;
        border-radius: 15px;
        font-weight: 700;
        display: inline-block;
        min-width: 90px;
    }

    .bg-admin {
        background-color: var(--color-primary-dark);
        color: white;
    }

    .bg-customer {
        background-color: var(--color-secondary-light);
        color: var(--color-primary-dark);
        border: 1px solid var(--color-primary-dark);
    }
</style>

<div class="card custom-card my-5">
    <div class="card-header custom-card-header text-center">
        <h2 class="fw-bold mb-0">User Management 💫</h2>
    </div>

    <div class="card-body p-4">
        <table id="tblData" class="table table-bordered table-striped align-middle" style="width:100%">
            <thead>
                <tr>
                    <th style="width:20%;">Name</th>
                    <th style="width:25%;">Email</th>
                    <th style="width:15%;">Phone</th>
                    <th style="width:20%;">Role</th>
                    <th style="width:20%;">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    @* يجب إدراج الأنماط المذكورة في القسم 1 هنا أو في ملف CSS خارجي *@
    <script src="~/js/User.js"></script>
    <script>
        /*
            ملاحظة: تحتاج إلى التأكد من أن ملف User.js يقوم بتهيئة DataTable
            ويستخدم حقول البيانات التالية:
            { "data": "name", "width": "20%" },
            { "data": "email", "width": "25%" },
            { "data": "phoneNumber", "width": "15%" },
            { "data": "role", "width": "20%", "render": function (data) {
                // منطق عرض الأدوار باستخدام CSS مخصص
                if (data === 'Admin') {
                    return '<span class="role-badge bg-admin">' + data + '</span>';
                } else {
                    return '<span class="role-badge bg-customer">' + data + '</span>';
                }
            }},
            { "data": "id", "render": function (data, type, row) {
                // بناء أزرار التعديل
                return '<div class="btn-group btn-actions-group" role="group">' +
                    '<a href="/Identity/Account/ManageRole?userId=' + data + '" class="btn btn-sm btn-info" title="Manage Role">' +
                        '<i class="bi bi-person-badge-fill"></i>' +
                    '</a>' +
                    // يمكنك إضافة زر قفل/إلغاء قفل هنا إذا لزم الأمر
                    '</div>';
            }, "width": "20%" }
        */
    </script>
}