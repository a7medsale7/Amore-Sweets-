@model Sweets.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<style>
    /* تم استخدام أنماط الـ Details الموحدة */
    :root {
        --color-primary-dark: #6B4226;
        --color-secondary-light: #F8BBD0;
        --color-accent: #FFF0D9;
    }

    .details-card {
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        border: 1px solid #e0e0e0;
    }

    .card-title-header {
        background-color: var(--color-primary-dark);
        color: white;
        border-top-left-radius: 14px;
        border-top-right-radius: 14px;
    }

    /* ✅ تعديل زر التعديل لضمان وضوح النص */
    .btn-action-primary {
        background-color: var(--color-primary-dark); /* اللون الأساسي الغامق */
        border-color: var(--color-primary-dark);
        color: white; /* لون النص الأبيض لضمان الوضوح */
        transition: background-color 0.3s;
    }

        .btn-action-primary:hover {
            background-color: #55341E;
            border-color: #55341E;
            color: white;
        }


    .section-box {
        background-color: var(--color-accent);
        padding: 25px;
        border-radius: 12px;
        border: 1px solid var(--color-secondary-light);
    }

    .dl-horizontal dt {
        color: var(--color-primary-dark);
        font-weight: 700;
        margin-bottom: 8px;
        border-bottom: 1px dashed rgba(107, 66, 38, 0.2);
        padding-bottom: 5px;
    }

    .dl-horizontal dd {
        margin-bottom: 15px;
        color: #495057;
    }

    .available-status-yes {
        color: #198754;
        font-weight: bold;
    }

    .available-status-no {
        color: #dc3545;
        font-weight: bold;
    }

    /* ✅ تعديل حجم الصورة وجعلها محاطة بإطار أوضح */
    .product-image-display {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 10px;
        border: 3px solid var(--color-secondary-light); /* إطار بلون فاتح وجميل */
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }
</style>

<div class="card details-card my-5">
    <div class="card-header card-title-header py-3">
        <h2 class="text-center mb-0">
            <i class="bi bi-eye-fill me-2"></i> Product Details: @Model.Name
        </h2>
    </div>

    <div class="card-body p-4 p-md-5">
        <div class="row g-4">
            <div class="col-md-7">
                <div class="section-box">
                    <h5 class="text-secondary mb-4 pb-2 border-bottom border-secondary-subtle">
                        <i class="bi bi-card-text me-1"></i> General Information
                    </h5>

                    <dl class="row dl-horizontal">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Slug</dt>
                        <dd class="col-sm-8">@Model.Slug</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8 text-wrap">@Html.Raw(Model.Description)</dd>

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@Model.Category?.Name</dd>
                    </dl>

                    <h5 class="text-secondary mb-4 pb-2 border-bottom border-secondary-subtle mt-4">
                        <i class="bi bi-currency-dollar me-1"></i> Pricing & Stock
                    </h5>

                    <dl class="row dl-horizontal">
                        <dt class="col-sm-4">Price</dt>
                        <dd class="col-sm-8"><span class="badge bg-success fs-6">@Model.Price.ToString("C")</span></dd>

                        <dt class="col-sm-4">Discount (%)</dt>
                        <dd class="col-sm-8"><span class="badge bg-warning text-dark fs-6">@Model.Discount%</span></dd>

                        <dt class="col-sm-4">Stock Quantity</dt>
                        <dd class="col-sm-8">@Model.StockQuantity</dd>
                    </dl>

                    <h5 class="text-secondary mb-4 pb-2 border-bottom border-secondary-subtle mt-4">
                        <i class="bi bi-clock me-1"></i> Dates & Status
                    </h5>

                    <dl class="row dl-horizontal">
                        <dt class="col-sm-4">Rating</dt>
                        <dd class="col-sm-8">@Model.Rating <i class="bi bi-star-fill text-warning"></i></dd>

                        <dt class="col-sm-4">Available</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsAvailable)
                            {
                                <span class="available-status-yes"><i class="bi bi-check-circle-fill me-1"></i> Yes</span>
                            }
                            else
                            {
                                <span class="available-status-no"><i class="bi bi-x-circle-fill me-1"></i> No</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Created At</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-4">Updated At</dt>
                        <dd class="col-sm-8">@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</dd>
                    </dl>
                </div>

                <div class="row pt-4">
                    <div class="col-6 col-md-4">
                        <a asp-action="Edit" asp-route-slug="@Model.Slug" class="btn btn-action-primary form-control shadow-sm fw-bold">
                            <i class="bi bi-pencil-square me-1"></i> Edit
                        </a>
                    </div>
                    <div class="col-6 col-md-4">
                        <a asp-action="Index" class="btn btn-outline-secondary border form-control shadow-sm fw-bold">
                            <i class="bi bi-arrow-left-circle-fill me-1"></i> Back
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="section-box h-100 text-center">
                    <h5 class="text-secondary mb-4 pb-2 border-bottom border-secondary-subtle">
                        <i class="bi bi-images me-1"></i> Product Images
                    </h5>

                    @if (Model.ProductImages != null && Model.ProductImages.Count > 0)
                    {
                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            @foreach (var img in Model.ProductImages)
                            {
                                <img src="@img.ImageUrl" class="product-image-display" />
                            }
                        </div>
                        <p class="text-muted mt-3">Total Images: @Model.ProductImages.Count</p>
                    }
                    else
                    {
                        <div class="p-5 text-muted fst-italic border rounded bg-white">No images uploaded for this product.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>